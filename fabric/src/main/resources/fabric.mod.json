{
  "schemaVersion": 1,
  "id": "youshallnottick",
  "version": "${version}",
  "name": "You Shall Not Tick",
  "description": "Disables unnecessary ticking for living entities.",
  "authors": [
    "JensenJ - Developer",
    "NoahS - Artist",
    "Yame5 - Artist"
  ],
  "contact": {
    "sources": "https://github.com/JensenJ-Modding/YouShallNotTick",
    "issues": "https://github.com/JensenJ-Modding/YouShallNotTick/issues"
  },
  "license": "MIT License",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.youshallnottick.fabric.YouShallNotTickModFabric"
    ],
    "client": [
      "net.youshallnottick.fabric.YouShallNotTickModFabricClient"
    ],
    "jade": [
      "net.youshallnottick.compat.jade.YouShallNotTickJadePlugin"
    ]
  },
  "mixins": [
    "youshallnottick-common.mixins.json",
    "youshallnottick-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "fabric": ">=0.116.0",
    "minecraft": ">=1.21.1",
    "architectury": ">=13.0.8",
    "forgeconfigapiport": ">=21.1.3"
  }
}